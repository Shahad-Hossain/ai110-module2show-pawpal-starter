classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str breed
        +float weight
        +int age
        +List~Task~ tasks
        +update_info(**changes) void
        +add_task(task) void
        +remove_task(task) void
        +get_tasks_for_day(day) List~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +str frequency
        +time preferred_time
        +bool completed
        +date due_date
        +update(**changes) void
        +mark_complete() Task
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +generate_plan(day) DailyPlan
        +sort_tasks(tasks) List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_tasks(pet_name, completed) List~Task~
        +filter_by_constraints(tasks, available_minutes) List~Task~
        +mark_task_complete(pet, task) Task
        +find_time_conflicts(day) List~str~
        +detect_conflicts(items) List~ScheduledItem~
        +explain_choice(item) str
    }

    class DailyPlan {
        +date day
        +List~ScheduledItem~ items
        +int total_minutes
        +List~Task~ skipped_tasks
        +List~str~ warnings
        +add_item(item) void
        +explain() str
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +time start_time
        +time end_time
        +str reason
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : uses
    Task ..> Task : mark_complete() creates next occurrence
    Scheduler --> Owner : plans for
    Scheduler ..> DailyPlan : creates
    Scheduler ..> ScheduledItem : creates
    Scheduler ..> Pet : adds recurring task to
    DailyPlan "1" *-- "0..*" ScheduledItem : contains
    ScheduledItem --> Task : schedules
    ScheduledItem --> Pet : for
